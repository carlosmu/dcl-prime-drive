    "deploy-env": "sdk-commands deploy-env",
    "start:bevy": "sdk-commands start"
  },
  "dependencies": {
    "@dcl-sdk/utils": "^1.4.0",
    "@dcl/js-runtime": "7.27.1-33533530571.commit-451d001",
    "@dcl/sdk": "7.27.1-33533530571.commit-451d001"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
