{
  "name": "prime-drive",
  "version": "1.0.0",
  "description": "Prime Drive - a 3-lane racing runner for Decentraland SDK7 with an authoritative server",
  "scripts": {
    "start": "node scripts/start.js",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@auth-server",
